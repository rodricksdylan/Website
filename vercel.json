{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["syd1"],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.insurai.com.au" }],
      "destination": "https://insurai.com.au/:path*",
      "permanent": true
    }
  ]
}
